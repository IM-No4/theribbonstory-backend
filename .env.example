PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/theribbonstory

# JWT
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Shiprocket API (Optional for logistics)
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# SMTP Email Configuration (Hostinger / Google Workspace / Amazon SES / Zoho)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@theribbonstory.com
SMTP_PASS=your_smtp_password_here

# Distinct Sender Emails
EMAIL_FROM_NOREPLY="The Ribbon Story" <no-reply@theribbonstory.com>
EMAIL_FROM_SUPPORT="The Ribbon Story Concierge" <support@theribbonstory.com>
EMAIL_FROM_CONTACT="The Ribbon Story Inquiries" <contact@theribbonstory.com>

# Google Gemini 3D Reference Engine (For Meshy / Tripo multi-view reference generation)
GEMINI_API_KEY=your_google_gemini_api_key_here

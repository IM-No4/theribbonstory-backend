PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/theribbonstory

# JWT (required in production; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Login sessions are an httpOnly cookie set on the API host. Leave unset unless the
# storefront and API need to share the cookie across subdomains (e.g. .theribbonstory.com)
COOKIE_DOMAIN=

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard > Settings > Webhooks: URL https://backend.theribbonstory.com/api/payments/razorpay/webhook,
# events payment.captured + order.paid, and this value as the secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Shiprocket API (Optional for logistics)
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
# Token set in Shiprocket > Settings > API > Webhooks (sent as the x-api-key header)
SHIPROCKET_WEBHOOK_TOKEN=replace-with-a-long-random-token

# Google Sign-In: OAuth Web Client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Admin account created on first start (password must be 12+ characters).
# In production no admin is created unless ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@theribbonstory.com
ADMIN_PASSWORD=

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# SMTP Email Configuration (Hostinger / Google Workspace / Amazon SES / Zoho)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@theribbonstory.com
SMTP_PASS=your_smtp_password_here

# Distinct Sender Emails
EMAIL_FROM_NOREPLY="The Ribbon Story" <no-reply@theribbonstory.com>
EMAIL_FROM_SUPPORT="The Ribbon Story Concierge" <support@theribbonstory.com>
EMAIL_FROM_CONTACT="The Ribbon Story Inquiries" <contact@theribbonstory.com>

# Google Gemini 3D Reference Engine (For Meshy / Tripo multi-view reference generation)
GEMINI_API_KEY=your_google_gemini_api_key_here
